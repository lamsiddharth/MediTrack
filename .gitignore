# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Local database and uploads
app/data/
*.db
*.db-wal
*.db-shm

# SSH private keys for the deployed instance - never commit these
*.pem

# Deployment facts written at launch time
deployed.txt
.static-ip

# Session signing key generated by deploy.sh
.secret-key

# Static AWS credentials for the app (Lightsail has no instance roles)
.aws-app-credentials

# Generated RDS password
.db-password

# Resource IDs recorded by infra scripts
infra/state.env
